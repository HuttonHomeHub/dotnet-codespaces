<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- Restore only from nuget.org, and map every package to it, so a package can never be
       pulled from an unexpected feed (https://learn.microsoft.com/nuget/consume-packages/package-source-mapping). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
