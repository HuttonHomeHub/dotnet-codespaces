@* A round icon at the top of the sign-in screens' message pages (check your email, password changed...). *@

<div class="auth-icon auth-icon-@Kind.ToString().ToLowerInvariant()" aria-hidden="true">
    @switch (Kind)
    {
        case AuthIconKind.Mail:
            <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
            break;
        case AuthIconKind.Success:
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m8 12.5 2.8 2.8L16.5 9.5" /></svg>
            break;
        case AuthIconKind.Lock:
            <svg viewBox="0 0 24 24"><rect x="5" y="10.5" width="14" height="10" rx="2.5" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" /></svg>
            break;
        default:
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.2v.3" /></svg>
            break;
    }
</div>

@code {
    [Parameter]
    public AuthIconKind Kind { get; set; }
}
