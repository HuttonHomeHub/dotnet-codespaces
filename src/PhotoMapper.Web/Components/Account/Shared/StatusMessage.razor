@if (!string.IsNullOrEmpty(DisplayMessage))
{
    // Messages starting "Error" show as errors; the prefix itself is dropped, the styling already says it.
    bool isError = DisplayMessage.StartsWith("Error", StringComparison.Ordinal);
    string text = isError ? DisplayMessage["Error".Length..].TrimStart(':', ' ') : DisplayMessage;
    <div class="alert alert-@(isError ? "danger" : "success")" role="alert">
        @text
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
