@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options

@inject IOptions<IdentityOptions> IdentityOptions

@* The password rules, from the app's Identity options, so the hint always matches what is enforced. Give the
   password field aria-describedby="@Id" so screen readers read it too. *@

<p class="auth-hint" id="@Id">@Text</p>

@code {
    [Parameter]
    public string Id { get; set; } = "password-requirements";

    private string Text
    {
        get
        {
            PasswordOptions rules = IdentityOptions.Value.Password;
            List<string> including = [];
            if (rules.RequireUppercase) including.Add("an uppercase letter");
            if (rules.RequireLowercase) including.Add("a lowercase letter");
            if (rules.RequireDigit) including.Add("a number");
            if (rules.RequireNonAlphanumeric) including.Add("a symbol");

            string length = $"At least {rules.RequiredLength} characters";
            return including.Count switch
            {
                0 => $"{length}.",
                1 => $"{length}, including {including[0]}.",
                _ => $"{length}, including {string.Join(", ", including[..^1])} and {including[^1]}.",
            };
        }
    }
}
