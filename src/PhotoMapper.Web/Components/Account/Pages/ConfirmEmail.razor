@page "/Account/ConfirmEmail"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using PhotoMapper.Data
@using PhotoMapper.Web.Email

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject NavigationManager NavigationManager
@inject AccountNotifications Notifications

@* Changed from the template: explains the admin approval step, and tells the admins about the new account. *@

<PageTitle>Confirm email · PhotoMapper</PageTitle>

<div class="auth-result">
    <AuthIcon Kind="@(statusMessage?.StartsWith("Error", StringComparison.Ordinal) == true ? AuthIconKind.Warning : AuthIconKind.Success)" />
    <h1>Confirm email</h1>
    <StatusMessage Message="@statusMessage" />
    <a class="auth-submit" href="Account/Login">Go to sign in</a>
</div>

@code {
    private const string InvalidLinkMessage =
        "Error: This confirmation link isn't valid or has expired. You can ask for a new one from the sign-in page.";

    private string? statusMessage;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Code is null)
        {
            RedirectManager.RedirectTo("");
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            // Changed from the template: no 404 status (the not-found page needs sign-in, so the visitor would just be
            // sent to the login page), and the same message as a wrong code, so it doesn't say which it was.
            statusMessage = InvalidLinkMessage;
        }
        else
        {
            bool wasConfirmed = user.EmailConfirmed;
            var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            var result = await UserManager.ConfirmEmailAsync(user, code);
            if (!result.Succeeded)
            {
                statusMessage = InvalidLinkMessage;
            }
            else if (user.IsApproved)
            {
                statusMessage = "Thank you for confirming your email.";
            }
            else
            {
                statusMessage = "Thank you for confirming your email. An admin needs to approve your account before you can sign in; you'll get an email when they have.";
                if (!wasConfirmed)
                {
                    // Only the first confirmation, so opening the link again doesn't email the admins again.
                    Uri reviewLink = NavigationManager.ToAbsoluteUri($"admin/users?q={Uri.EscapeDataString(user.Email ?? "")}");
                    await Notifications.NewAccountWaitingAsync(user, reviewLink);
                }
            }
        }
    }
}
