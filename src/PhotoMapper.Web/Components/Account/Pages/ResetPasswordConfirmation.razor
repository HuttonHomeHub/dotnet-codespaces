@page "/Account/ResetPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
<PageTitle>Password updated · PhotoMapper</PageTitle>

<div class="auth-result">
    <AuthIcon Kind="AuthIconKind.Success" />
    <h1>Password updated</h1>
    <p class="auth-lead" role="alert">Your password has been reset. You can now sign in with your new password.</p>
    <a class="auth-submit" href="Account/Login">Sign in</a>
</div>
