@page "/Account/ForgotPasswordConfirmation"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Check your email · PhotoMapper</PageTitle>

<div class="auth-result">
    <AuthIcon Kind="AuthIconKind.Mail" />
    <h1>Check your email</h1>
    <p class="auth-lead" role="alert">If there's an account for that address, we've sent a link to reset your password.</p>
    <a class="auth-submit" href="Account/Login">Back to sign in</a>
</div>
