@page "/Account/InvalidPasswordReset"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Link not valid · PhotoMapper</PageTitle>

<div class="auth-result">
    <AuthIcon Kind="AuthIconKind.Warning" />
    <h1>This link isn't valid</h1>
    <p class="auth-lead" role="alert">The password reset link is invalid or has expired. You can ask for a new one.</p>
    <a class="auth-submit" href="Account/ForgotPassword">Send a new link</a>
</div>
