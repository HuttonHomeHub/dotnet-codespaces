@page "/Account/InvalidUser"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Account not found · PhotoMapper</PageTitle>

<div class="auth-result">
    <AuthIcon Kind="AuthIconKind.Warning" />
    <h1>Account not found</h1>
    <StatusMessage />
    <a class="auth-submit" href="Account/Login">Back to sign in</a>
</div>
