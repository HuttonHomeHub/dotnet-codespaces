@page "/Account/Lockout"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Account locked · PhotoMapper</PageTitle>

<div class="auth-result">
    <AuthIcon Kind="AuthIconKind.Lock" />
    <h1>Account locked</h1>
    <p class="auth-lead" role="alert">This account has been locked out, please try again later. If it was locked by an admin, contact them to unlock it.</p>
    <a class="auth-submit" href="Account/Login">Back to sign in</a>
</div>
