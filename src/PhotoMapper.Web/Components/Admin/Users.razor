@page "/admin/users"
@attribute [Authorize(Roles = AppRoles.Admin)]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PhotoMapper.Data
@using PhotoMapper.Web.Components.Account.Shared

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager

@* The actions post to AdminUserEndpoints, which enforce the rules (admins only, never your own account). *@

<PageTitle>Users</PageTitle>

<h1>Users</h1>

<StatusMessage />

@if (pendingCount > 0)
{
    <p>
        <a href="admin/users?status=pending" class="btn btn-sm btn-warning">@pendingCount waiting for approval</a>
        @if (Status == "pending")
        {
            <a href="admin/users" class="btn btn-sm btn-link">Show all users</a>
        }
    </p>
}

<form method="get" class="row g-2 mb-3" role="search">
    <div class="col-sm-8 col-md-6">
        <input type="search" name="q" value="@Q" class="form-control" placeholder="Search by email" aria-label="Search by email" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (users.Count == 0)
{
    <p>No users found.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Joined</th>
                    <th>Email confirmed</th>
                    <th>Status</th>
                    <th>Admin</th>
                    <th><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (ApplicationUser user in users)
                {
                    bool isAdmin = adminIds.Contains(user.Id);
                    bool isLocked = user.LockoutEnd > DateTimeOffset.UtcNow;
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.CreatedAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td>
                        <td>@(user.EmailConfirmed ? "Yes" : "No")</td>
                        <td>@(isLocked ? "Locked" : user.IsApproved ? "Active" : "Waiting for approval")</td>
                        <td>@(isAdmin ? "Yes" : "No")</td>
                        <td class="text-nowrap">
                            @if (user.Id == currentUserId)
                            {
                                <span class="text-secondary">This is you</span>
                            }
                            else
                            {
                                @if (!user.IsApproved)
                                {
                                    <form method="post" action="@($"admin/users/{user.Id}/approve")" class="d-inline">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="returnUrl" value="@currentPage" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                }
                                <form method="post" action="@($"admin/users/{user.Id}/{(isLocked ? "unlock" : "lock")}")" class="d-inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="@currentPage" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(isLocked ? "Unlock" : "Lock")</button>
                                </form>
                                <form method="post" action="@($"admin/users/{user.Id}/{(isAdmin ? "remove-admin" : "grant-admin")}")" class="d-inline">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="returnUrl" value="@currentPage" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">@(isAdmin ? "Remove admin" : "Make admin")</button>
                                </form>
                                <a href="@($"admin/users/{user.Id}/delete")" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Pages" class="d-flex gap-2 align-items-center">
        @if (Page > 1)
        {
            <a class="btn btn-sm btn-outline-primary" href="@PageLink(Page - 1)">Previous</a>
        }
        <span>Page @Page of @pageCount (@total users)</span>
        @if (Page < pageCount)
        {
            <a class="btn btn-sm btn-outline-primary" href="@PageLink(Page + 1)">Next</a>
        }
    </nav>
}

@code {
    private const int PageSize = 25;

    private List<ApplicationUser> users = [];
    private HashSet<string> adminIds = [];
    private string? currentUserId;
    private string currentPage = "/admin/users";
    private int total;
    private int pageCount = 1;
    private int pendingCount;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Q { get; set; }

    // "pending": only accounts waiting for approval.
    [SupplyParameterFromQuery]
    private string? Status { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    private int Page { get; set; }

    protected override async Task OnInitializedAsync()
    {
        currentUserId = UserManager.GetUserId(HttpContext.User);
        currentPage = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);

        IQueryable<ApplicationUser> query = UserManager.Users;
        if (!string.IsNullOrWhiteSpace(Q))
        {
            string search = Q.Trim().ToUpperInvariant();
            query = query.Where(user => user.NormalizedEmail != null && user.NormalizedEmail.Contains(search));
        }

        if (Status == "pending")
        {
            query = query.Where(user => !user.IsApproved);
        }

        pendingCount = await UserManager.Users.CountAsync(user => !user.IsApproved);

        total = await query.CountAsync();
        pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        Page = Math.Clamp(Page, 1, pageCount);

        users = await query
            .OrderBy(user => user.NormalizedEmail)
            .Skip((Page - 1) * PageSize)
            .Take(PageSize)
            .ToListAsync();

        adminIds = (await UserManager.GetUsersInRoleAsync(AppRoles.Admin)).Select(user => user.Id).ToHashSet();
    }

    private string PageLink(int page) =>
        NavigationManager.GetUriWithQueryParameters(new Dictionary<string, object?> { ["page"] = page, ["q"] = Q, ["status"] = Status });
}
