# Copy to site.env on the server and fill in. site.env is server-specific and never committed.

# Public hostname. Caddy gets a Let's Encrypt certificate for it, so DNS must point here and ports 80/443 be open.
# Use ":80" to serve plain HTTP (for example for a local test).
SITE_ADDRESS=photos.example.com

# Host ports for the proxy (defaults 80 and 443).
#PROXY_HTTP_PORT=80
#PROXY_HTTPS_PORT=443
