# Copy to site.env on the server and fill in. site.env is server-specific, holds secrets and is never committed.

# Public hostname. Caddy gets a Let's Encrypt certificate for it, so DNS must point here and ports 80/443 be open.
# Use ":80" to serve plain HTTP (for example for a local test).
SITE_ADDRESS=photos.example.com

# Password for the PostgreSQL "postgres" user. Set once, before the first start: the database is created with it,
# and changing it later does not change the existing database's password. Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=

# SMTP provider for account emails (confirmation, password reset), as a connection string:
#   Endpoint=smtp://host:587;Username=...;Password=...    STARTTLS (required)
#   Endpoint=smtps://host:465;Username=...;Password=...   implicit TLS
# Quote a password that contains ';' (Password="a;b").
MAIL=

# Sender for account emails; must be an address your provider lets you send from.
MAIL_FROM=PhotoMapper <no-reply@photos.example.com>

# Host ports for the proxy (defaults 80 and 443).
#PROXY_HTTP_PORT=80
#PROXY_HTTPS_PORT=443
