<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for the build to report unused usings (IDE0005); XML doc comments themselves stay optional. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Supply chain">
    <!-- Fail restore on known-vulnerable direct or transitive packages. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- Commit packages.lock.json; CI restores in locked mode so the graph can't drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <PropertyGroup Label="Containers">
    <!-- Used by dotnet publish -t:PublishContainer (see .github/workflows/deploy.yml). Chiseled images have no shell or
         package manager and run as a non-root user; "extra" keeps ICU and tzdata for culture and time zone support. -->
    <ContainerFamily>noble-chiseled-extra</ContainerFamily>
  </PropertyGroup>

  <ItemGroup Label="Containers">
    <!-- Links the GHCR packages to this repository, so they inherit its visibility and access. -->
    <ContainerLabel Include="org.opencontainers.image.source" Value="https://github.com/HuttonHomeHub/dotnet-codespaces" />
  </ItemGroup>

  <PropertyGroup Label="CI" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <RestoreLockedMode>true</RestoreLockedMode>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
