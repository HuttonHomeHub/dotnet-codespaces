{
    "name": "PhotoMapper",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/powershell:2": {
            "version": "latest"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "GitHub.copilot",
                "GitHub.vscode-github-actions",
                "ms-dotnettools.csdevkit"
            ]
        }
    },
    "forwardPorts": [
        15051,
        8080,
        8081
    ],
    "postCreateCommand": "dotnet tool install -g Aspire.Cli --version 13.6.1 && dotnet restore PhotoMapper.slnx",
    "hostRequirements": {
        "memory": "8gb",
        "cpus": 4
    },
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/root/.dotnet/tools"
    },
    "portsAttributes": {
        "15051": {
            "label": "Aspire Dashboard",
            "onAutoForward": "notify"
        },
        "8080": {
            "label": "API",
            "onAutoForward": "notify"
        },
        "8081": {
            "label": "Web",
            "onAutoForward": "notify"
        }
    }
}
