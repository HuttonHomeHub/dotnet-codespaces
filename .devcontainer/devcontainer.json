{
    "name": "PhotoMapper",
    "image": "mcr.microsoft.com/dotnet/sdk:10.0",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4": {},
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "2"
        },
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": false,
            "installOhMyZsh": false,
            "installOhMyZshConfig": false
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "EditorConfig.EditorConfig",
                "GitHub.vscode-github-actions",
                "GitHub.vscode-pull-request-github",
                "microsoft-aspire.aspire-vscode",
                "ms-azuretools.vscode-containers",
                "ms-dotnettools.csdevkit",
                "timonwong.shellcheck"
            ]
        }
    },
    "forwardPorts": [
        15051,
        8080,
        8081
    ],
    "postCreateCommand": "dotnet tool install -g Aspire.Cli --version 13.6.1 && dotnet tool restore && dotnet restore PhotoMapper.slnx",
    "hostRequirements": {
        "memory": "8gb",
        "cpus": 4
    },
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/workspaces/.claude-code"
    },
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/root/.dotnet/tools"
    },
    "portsAttributes": {
        "15051": {
            "label": "Aspire Dashboard",
            "onAutoForward": "notify"
        },
        "8080": {
            "label": "API",
            "onAutoForward": "notify"
        },
        "8081": {
            "label": "Web",
            "onAutoForward": "notify"
        }
    },
    "otherPortsAttributes": {
        "onAutoForward": "ignore"
    }
}
