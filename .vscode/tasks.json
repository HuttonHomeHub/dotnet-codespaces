{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run (aspire, hot reload)",
            "command": "aspire",
            "type": "process",
            "args": [
                "run"
            ],
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/PhotoMapper.slnx",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": [
                "test",
                "--solution",
                "${workspaceFolder}/PhotoMapper.slnx"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "format",
            "command": "dotnet",
            "type": "process",
            "args": [
                "format",
                "${workspaceFolder}/PhotoMapper.slnx"
            ],
            "problemMatcher": []
        }
    ]
}
